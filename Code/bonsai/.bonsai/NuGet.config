<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources of the Buridan Bonsai environment:
    - nuget.org for Bonsai and its packages,
    - ..\packages (bonsai\packages) for Buridan.Bonsai, built by ..\build.ps1.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Buridan" value="..\packages" />
  </packageSources>
</configuration>
