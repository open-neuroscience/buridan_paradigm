<?xml version="1.0" encoding="utf-8"?>
<!--
  Bonsai environment for the Buridan arena.

  Only the top-level packages are listed. The first time Setup.cmd is run,
  Bonsai downloads itself (version 2.9.1), installs these packages and their
  dependencies, and fills in the rest of this file automatically.

  Buridan.Bonsai comes from the local folder ..\packages (see NuGet.config);
  rebuild it with ..\build.ps1 after changing the C# code.
-->
<PackageConfiguration xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Packages>
    <Package id="Bonsai" version="2.9.1" />
    <Package id="Bonsai.Core" version="2.9.1" />
    <Package id="Bonsai.Design" version="2.9.1" />
    <Package id="Bonsai.Editor" version="2.9.1" />
    <Package id="Bonsai.Design.Visualizers" version="2.9.1" />
    <Package id="Bonsai.Vision" version="2.9.1" />
    <Package id="Bonsai.Vision.Design" version="2.9.1" />
    <Package id="Bonsai.Gui" version="0.2.0" />
    <Package id="Bonsai.ZeroMQ" version="0.3.0" />
    <Package id="BonVision" version="0.12.0" />
    <Package id="Buridan.Bonsai" version="0.1.0" />
  </Packages>
  <AssemblyReferences />
  <AssemblyLocations />
  <LibraryFolders />
</PackageConfiguration>
