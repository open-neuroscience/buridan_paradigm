      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Protocol" DisplayName="Protocol" Description="The protocol being edited. Expand it to set the name, frame rate and epochs." Category="2. Protocol editor" />
        <Property Name="UploadToPi" DisplayName="Also save on the Pi" Description="If true, saved protocols are also stored on the Raspberry Pi." Category="2. Protocol editor" />
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="ProtocolFolder" DisplayName="Protocol folder" Description="Folder on this PC containing the protocol files." Category="1. Experiment" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:SaveProtocol">
