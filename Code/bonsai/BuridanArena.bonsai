                <p1:DutyCycle>0.5</p1:DutyCycle>
                <p1:PhaseDeg>0</p1:PhaseDeg>
                <p1:BarRegionCenterDeg>0</p1:BarRegionCenterDeg>
                <p1:RegionAWidthDeg>90</p1:RegionAWidthDeg>
                <p1:RegionABars>3</p1:RegionABars>
                <p1:RegionABarFraction>0.25</p1:RegionABarFraction>
                <p1:RegionBWidthDeg>90</p1:RegionBWidthDeg>
