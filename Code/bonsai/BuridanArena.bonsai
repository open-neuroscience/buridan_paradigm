      <Expression xsi:type="ExternalizedMapping">
        <Property Name="DataFolder" DisplayName="Data folder" Description="Folder on this PC where experiment data is saved. A sub-folder is created for every run." Category="1. Experiment" />
        <Property Name="AnimalId" DisplayName="Animal ID" Description="Identifier of the animal, used in the session folder name." Category="1. Experiment" />
        <Property Name="Experimenter" DisplayName="Experimenter" Description="Name of the experimenter (saved in session.json)." Category="1. Experiment" />
        <Property Name="Notes" DisplayName="Notes" Description="Free-text notes about this run (saved in session.json)." Category="1. Experiment" />
      </Expression>
