                <p1:Type>Stripes</p1:Type>
                <p1:DurationSeconds>60</p1:DurationSeconds>
                <p1:StripeCentersDeg>
                  <p1:double>0</p1:double>
                  <p1:double>180</p1:double>
                </p1:StripeCentersDeg>
                <p1:StripeWidthDeg>11.25</p1:StripeWidthDeg>
                <p1:StripeTopPx>0</p1:StripeTopPx>
                <p1:StripeBottomPx>63</p1:StripeBottomPx>
                <p1:PeriodDeg>30</p1:PeriodDeg>
                <p1:SpeedDegPerSecond>45</p1:SpeedDegPerSecond>
                <p1:Direction>Clockwise</p1:Direction>
                <p1:Waveform>Square</p1:Waveform>
                <p1:DutyCycle>0.5</p1:DutyCycle>
                <p1:PhaseDeg>0</p1:PhaseDeg>
                <p1:BarRegionCenterDeg>0</p1:BarRegionCenterDeg>
                <p1:RegionAWidthDeg>90</p1:RegionAWidthDeg>
                <p1:RegionABars>3</p1:RegionABars>
                <p1:RegionABarFraction>0.25</p1:RegionABarFraction>
                <p1:RegionBWidthDeg>90</p1:RegionBWidthDeg>
                <p1:RegionBBars>3</p1:RegionBBars>
                <p1:RegionBBarFraction>0.25</p1:RegionBBarFraction>
                <p1:StripeColor>Black</p1:StripeColor>
                <p1:BackgroundColor>White</p1:BackgroundColor>
                <p1:ColorA>White</p1:ColorA>
                <p1:ColorB>Black</p1:ColorB>
                <p1:BarColor>Black</p1:BarColor>
                <p1:BarBackgroundColor>White</p1:BarBackgroundColor>
                <p1:BlankColor>Black</p1:BlankColor>
              </p1:Epoch>
              <p1:Epoch>
                <p1:Type>Stripes</p1:Type>
                <p1:DurationSeconds>60</p1:DurationSeconds>
                <p1:StripeCentersDeg>
